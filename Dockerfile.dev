FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.6.14 /uv /uvx /bin/
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_COMPILE_BYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN useradd --create-home --uid 1000 appuser && mkdir -p /opt/venv && chown -R appuser:appuser /opt/venv /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --all-groups
COPY --chown=appuser:appuser . .
USER appuser
CMD ["sleep", "infinity"]

